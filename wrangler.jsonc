{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rassegna-finanziaria",
  "main": "worker.js",
  "compatibility_date": "2026-07-27",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "triggers": {
    "crons": [
      "0 11 * * *",
      "0 12 * * *"
    ]
  },
  "observability": {
    "enabled": true
  }
}